@using System.Globalization
@model PasswordViewModel
@{
    var sv = CultureInfo.GetCultureInfo("sv-SE");
    string When(DateTime t) => t.Date == Model.Now.Date
        ? t.ToString("HH:mm", sv)
        : t.ToString("dddd d MMMM HH:mm", sv);
}

@if (Model.Active is not null)
{
    <p class="label">Lösenord</p>
    <p class="value">@Model.Active.Password</p>
    <p class="meta">Tentastart @When(Model.Active.StartTime)</p>
}
else if (Model.NextStart is DateTime next)
{
    <p class="message">
        Lösenordet visas från @When(next.AddMinutes(-Model.ShowBeforeStartMinutes))
        (tentastart @When(next)).
    </p>
}
else
{
    <p class="message">Ingen kommande tenta för @Model.Campus.</p>
}
