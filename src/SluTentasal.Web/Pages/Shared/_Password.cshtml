@using System.Globalization
@model PasswordViewModel
@{
    var sv = CultureInfo.GetCultureInfo("sv-SE");
    // Väntläget gäller bara dagens tentor, men ett aktivt fönster kan passera midnatt.
    string When(DateTime t) =>
        t.Date == Model.Now.Date ? t.ToString("HH:mm", sv)
        : t.Date == Model.Now.Date.AddDays(1) ? $"imorgon {t.ToString("HH:mm", sv)}"
        : t.Date == Model.Now.Date.AddDays(-1) ? $"igår {t.ToString("HH:mm", sv)}"
        : t.ToString("d MMMM HH:mm", sv);

    string Until(DateTime t)
    {
        var minutes = (int)Math.Ceiling((t - Model.Now).TotalMinutes);
        return minutes >= 60 ? $"om {minutes / 60} h {minutes % 60} min" : $"om {minutes} min";
    }
}

@if (Model.Active is not null)
{
    <div class="panel active" style="--len: @Math.Max(Model.Active.Password.Length, 8)">
        <p class="label">Lösenord</p>
        <p class="value">@Model.Active.Password</p>
        <p class="meta">
            Tentastart @When(Model.Active.StartTime)
            <span class="sep">·</span>
            visas till @When(Model.Active.StartTime.AddMinutes(Model.ShowAfterStartMinutes))
        </p>
    </div>
}
else if (Model.NextStart is DateTime next)
{
    var showFrom = next.AddMinutes(-Model.ShowBeforeStartMinutes);
    <div class="panel waiting">
        <p class="headline">Lösenordet visas kl @When(showFrom)</p>
        <p class="meta">
            Tentastart @When(next)
            <span class="sep">·</span>
            @Until(next)
        </p>
    </div>
}
else
{
    <div class="panel idle">
        <p class="headline">Inga fler tentor i dag</p>
    </div>
}
