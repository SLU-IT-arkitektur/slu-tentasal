{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "Tentasal": ""
  },
  "Tentasal": {
    "ShowBeforeStartMinutes": 30,
    "ShowAfterStartMinutes": 45,
    "PasswordPollSeconds": 5,
    "TimeZone": "Europe/Stockholm"
  }
}
